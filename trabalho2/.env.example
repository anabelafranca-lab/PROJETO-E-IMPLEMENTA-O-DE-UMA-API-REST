# Porta do servidor Express
PORT=3000

# Qual implementação de repositório usar (Factory em src/repositories/criarPersistencia.js):
#   sequelize -> persiste no banco relacional (padrão)
#   memory    -> repositórios em memória (sem banco; dados somem ao reiniciar)
REPOSITORY_DRIVER=sequelize

# Banco de dados (usado quando REPOSITORY_DRIVER=sequelize)
# SQLite por padrão: um arquivo local, sem instalar SGBD (justificativa no README).
DB_DIALECT=sqlite
DB_STORAGE=./data/dev.sqlite3

# --- Para PostgreSQL/MySQL, descomente e preencha: ---
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=biblioteca_escolar
