# Porta do servidor Express
PORT=3000

# Banco de dados
# Por padrão o projeto usa SQLite (arquivo local em data/dev.sqlite3),
# o que dispensa instalar/configurar um SGBD separado para rodar o projeto.
# Veja a justificativa completa no README.
DB_DIALECT=sqlite
DB_STORAGE=./data/dev.sqlite3

# --- Para usar PostgreSQL/MySQL em vez de SQLite, descomente e preencha: ---
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=biblioteca_escolar
