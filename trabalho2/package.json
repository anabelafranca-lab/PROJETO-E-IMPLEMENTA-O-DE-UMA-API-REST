{
  "name": "trabalho3-api-biblioteca-escolar",
  "version": "3.0.0",
  "description": "Trabalho 3 - API da biblioteca escolar reestruturada em camadas (MVC), com Repository, Injeção de Dependência, Factory, DTO e Observer",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "start:memoria": "cross-env REPOSITORY_DRIVER=memory node src/server.js",
    "test": "jest --runInBand",
    "test:memoria": "cross-env REPOSITORY_DRIVER=memory jest --runInBand",
    "test:postman": "node scripts/testarPostman.js",
    "lint": "eslint . --max-warnings 0",
    "verificar": "npm run lint && npm test && npm run test:memoria && npm run test:postman",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "rimraf data/dev.sqlite3 && npm run db:migrate && npm run db:seed"
  },
  "keywords": ["api", "rest", "express", "mvc", "camadas", "repository", "injecao-de-dependencia"],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sequelize": "^6.37.8",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.7.0",
    "newman": "^6.2.1",
    "nodemon": "^3.1.4",
    "rimraf": "^5.0.10",
    "sequelize-cli": "^6.6.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/helpers/globalSetup.js",
    "testPathIgnorePatterns": ["/node_modules/", "/tests/helpers/"]
  }
}
